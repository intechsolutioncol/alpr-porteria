*.pt
!modelos/best.pt

# Datos generados por los scripts (todos regenerables, muy pesados para git)
data/reales/
data/sinteticas/
data/dataset/
data/dataset.zip
data/fondos_reales/
resultados/

# Archivos temporales de conversión a PDF
